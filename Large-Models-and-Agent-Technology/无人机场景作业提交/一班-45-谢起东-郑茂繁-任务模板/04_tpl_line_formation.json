{
  "id": "tpl_line_formation",
  "template": {
    "name": "Two-Drone Line-Abreast Formation",
    "description": "Two drones take off to the same altitude and hold a lateral separation of about 200 m. Needs at least two drones in the session.",
    "content": "Put {drone_1_name} and {drone_2_name} in the air at {random_alt:22:30:1} meters. {drone_1_name} holds over (280, 380) and {drone_2_name} holds over (480, 380), so the pair keeps a 200 meter lateral spacing while both hover.",
    "content_aliases": [
      "Both {drone_1_name} and {drone_2_name} climb to {random_alt:22:30:1} m and hold a line abreast formation 200 m apart.",
      "Formation: {drone_1_name} at (280, 380), {drone_2_name} at (480, 380), both at {random_alt:22:30:1} m, gap 200 m.",
      "Keep {drone_1_name} and {drone_2_name} flying at {random_alt:22:30:1} m, side by side, 200 m apart."
    ],
    "category": "Formation",
    "difficulty": "medium",
    "creator": "Xie Qidong",
    "is_builtin": false,
    "suitable_task": [
      "others",
      "area_assignment_and_patrol"
    ],
    "exclude_in_random_generation": false,
    "related_apis": [
      {
        "endpoint": "/drones/{id}/command/take_off",
        "parameters": {
          "id": "{drone_1_id}",
          "altitude": "{random_alt:22:30:1}"
        }
      },
      {
        "endpoint": "/drones/{id}/command/take_off",
        "parameters": {
          "id": "{drone_2_id}",
          "altitude": "{random_alt:22:30:1}"
        }
      },
      {
        "endpoint": "/drones/{id}/command/move_to",
        "parameters": {
          "id": "{drone_1_id}",
          "x": 280,
          "y": 380,
          "z": "{random_alt:22:30:1}"
        }
      },
      {
        "endpoint": "/drones/{id}/command/move_to",
        "parameters": {
          "id": "{drone_2_id}",
          "x": 480,
          "y": 380,
          "z": "{random_alt:22:30:1}"
        }
      },
      {
        "endpoint": "/drones/{id}/command/hover",
        "parameters": {
          "id": "{drone_1_id}"
        }
      },
      {
        "endpoint": "/drones/{id}/command/hover",
        "parameters": {
          "id": "{drone_2_id}"
        }
      }
    ],
    "execution_check_apis": {
      "logic": "and",
      "checks": [
        {
          "endpoint": "/check/two_drones_distance",
          "parameters": {
            "drone_1_id": "{drone_1_id}",
            "drone_2_id": "{drone_2_id}",
            "max_distance": 210
          }
        },
        {
          "endpoint": "/check/drone_altitude",
          "parameters": {
            "drone_id": "{drone_1_id}",
            "expected_altitude": "{random_alt:22:30:1}",
            "tolerance": 2.0
          }
        },
        {
          "endpoint": "/check/drone_altitude",
          "parameters": {
            "drone_id": "{drone_2_id}",
            "expected_altitude": "{random_alt:22:30:1}",
            "tolerance": 2.0
          }
        }
      ]
    },
    "commands": [
      "take_off",
      "move_to",
      "hover"
    ]
  }
}