      "endpoint": "POST /drones/{id}/command/take_photo",
      "params": {},
      "desc": "拍照"
    },
    "broadcast": {
      "endpoint": "POST /drones/{id}/command/broadcast",
      "params": {
        "content": "str (required)"
      },
      "desc": "广播消息"
    },
    "send_message": {
      "endpoint": "POST /drones/{id}/command/send_message",
      "params": {
        "target_drone_id": "str (required, query)",
        "message": "str (required, query)"
      },
      "desc": "给指定无人机发消息（中继任务）"
    },
    "charge": {
      "endpoint": "POST /drones/{id}/command/charge",
      "params": {
        "charge_amount": "float percent (optional, query)"
      },
      "desc": "充电"
    },
    "return_home": {
      "endpoint": "POST /drones/{id}/command/return_home",
      "params": {},
      "desc": "返航"
    }
