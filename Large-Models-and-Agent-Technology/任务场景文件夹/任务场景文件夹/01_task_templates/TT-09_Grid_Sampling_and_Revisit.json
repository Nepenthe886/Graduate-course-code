{
  "schema_version": "1.0",
  "template_id": "TT-09",
  "name": "Grid Sampling and Revisit",
  "language": "en",
  "category": "sampling",
  "difficulty": 3,
  "version": "1.0",
  "summary": "Collect sensor samples on a fixed grid and return to the same points at a required interval.",
  "objective": "Collect at least {revisit_count} sensor samples at each of {n_points} grid points inside {grid_area} with a revisit interval of {interval_min} +/- 2 min, and keep every sample geotagged within 5 m.",
  "brief": "Sample the {n_points} points of the {grid_area} grid with the {sensor} sensor. Every point needs at least {revisit_count} samples, taken {interval_min} +/- 2 min apart, and each sample must be geotagged within 5 m. Plan the order so that the revisit interval is respected without waiting on the ground.",
  "agents": {
    "min": 1,
    "max": 4,
    "rec": 2
  },
  "parameters": [
    {
      "name": "grid_area",
      "type": "zone_ref",
      "unit": "zone id",
      "required": true,
      "desc": "Sampling grid area",
      "example": "GRID-ORCHARD"
    },
    {
      "name": "n_points",
      "type": "int",
      "unit": "points",
      "required": true,
      "desc": "Number of sample points",
      "example": 12,
      "range": [
        8,
        20
      ]
    },
    {
      "name": "interval_min",
      "type": "int",
      "unit": "min",
      "required": true,
      "desc": "Revisit interval",
      "example": 8,
      "range": [
        6,
        12
      ]
    },
    {
      "name": "revisit_count",
      "type": "int",
      "unit": "samples/point",
      "required": true,
      "desc": "Samples required per point",
      "example": 2,
      "range": [
        2,
        3
      ]
    },
    {
      "name": "sensor",
      "type": "enum",
      "unit": "sensor",
      "required": true,
      "desc": "Sensor used for the samples",
      "example": "thermal",
      "choices": [
        "RGB",
        "thermal",
        "multispectral",
        "gas"
      ]
    }
  ],
  "preconditions": [
    "sensor warmed up and calibrated",
    "grid geometry published to the team"
  ],
  "mission_phases": [
    {
      "phase": "1-plan",
      "actions": [
        "order the {n_points} points into a route that meets the {interval_min} min revisit",
        "assign points to UAVs"
      ],
      "output": "sampling schedule"
    },
    {
      "phase": "2-sample",
      "actions": [
        "fly to each point",
        "hold >= 3 s and take the {sensor} sample"
      ],
      "output": "sample log"
    },
    {
      "phase": "3-revisit",
      "actions": [
        "return to each point {interval_min} min after the first sample",
        "take the repeat sample"
      ],
      "output": "revisit log"
    },
    {
      "phase": "4-upload",
      "actions": [
        "upload samples",
        "verify checksums and geotags"
      ],
      "output": "complete data set"
    },
    {
      "phase": "5-recover",
      "actions": [
        "land at {lz}"
      ],
      "output": "recovered fleet"
    }
  ],
  "checkpoints": [
    {
      "id": "CP-1",
      "name": "Sample completeness",
      "metric": "samples collected per grid point",
      "target": ">= {revisit_count} samples at all {n_points} points",
      "verify": "platform payload log",
      "weight": 30
    },
    {
      "id": "CP-2",
      "name": "Revisit timing",
      "metric": "interval between samples at the same point",
      "target": "{interval_min} +/- 2 min",
      "verify": "platform payload log",
      "weight": 20
    },
    {
      "id": "CP-3",
      "name": "Geotag accuracy",
      "metric": "sample position error",
      "target": "<= 5 m per sample",
      "verify": "platform payload metadata",
      "weight": 20
    },
    {
      "id": "CP-4",
      "name": "Data integrity",
      "metric": "uploaded samples and checksum status",
      "target": "100% uploaded, checksums OK",
      "verify": "platform data log",
      "weight": 15
    },
    {
      "id": "CP-5",
      "name": "Recovery",
      "metric": "all UAVs landed at {lz}",
      "target": "all on ground, no hard landing",
      "verify": "platform landing log",
      "weight": 15
    }
  ],
  "failure_conditions": [
    "fewer than half of the points visited",
    "revisit interval outside 50% tolerance",
    "corrupted sample set"
  ],
  "constraints": [
    "hover >= 3 s at every point",
    "no sampling above 30 m AGL"
  ],
  "generation_rules": {
    "sampling": {
      "n_points": [
        8,
        10,
        12,
        16,
        20
      ],
      "interval_min": [
        6,
        8,
        10,
        12
      ],
      "revisit_count": [
        2,
        3
      ],
      "sensor": [
        "RGB",
        "thermal",
        "multispectral",
        "gas"
      ]
    },
    "variants": [
      "day",
      "dawn mist",
      "night"
    ]
  },
  "instance_example": {
    "grid_area": "GRID-ORCHARD",
    "n_points": 12,
    "interval_min": 8,
    "revisit_count": 2,
    "sensor": "thermal"
  },
  "grading": "global checkpoint pass rate; checkpoint weights sum to 100"
}
