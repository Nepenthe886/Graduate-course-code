{
  "schema_version": "1.0",
  "template_id": "TT-07",
  "name": "Communication Relay Chain",
  "language": "en",
  "category": "comms",
  "difficulty": 3,
  "version": "1.0",
  "summary": "Build and hold an airborne relay chain so that two ground elements keep a usable link.",
  "objective": "Position {hops} UAVs so that {site_a} and {site_b} keep an end-to-end link with RSSI >= {min_rssi_dbm} dBm for {hold_min} min, and rebuild the chain within 45 s if one relay is lost.",
  "brief": "Link {site_a} and {site_b}, which are {separation_m} m apart and cannot see each other. Fly a relay chain of {hops} UAVs at {chain_alt_m} m AGL, keep the end-to-end link above {min_rssi_dbm} dBm for {hold_min} min, and rebuild the chain within 45 s if a relay drops. No UAV may hover closer than {min_sep_m} m to another.",
  "agents": {
    "min": 2,
    "max": 4,
    "rec": 3
  },
  "parameters": [
    {
      "name": "site_a",
      "type": "zone_ref",
      "unit": "zone id",
      "required": true,
      "desc": "First ground station",
      "example": "GS-BASE"
    },
    {
      "name": "site_b",
      "type": "zone_ref",
      "unit": "zone id",
      "required": true,
      "desc": "Second ground station (blocked line of sight)",
      "example": "GS-VALLEY"
    },
    {
      "name": "hops",
      "type": "int",
      "unit": "relays",
      "required": true,
      "desc": "Number of relay UAVs",
      "example": 2,
      "range": [
        2,
        4
      ]
    },
    {
      "name": "chain_alt_m",
      "type": "int",
      "unit": "m AGL",
      "required": true,
      "desc": "Relay altitude",
      "example": 120,
      "range": [
        80,
        160
      ]
    },
    {
      "name": "min_rssi_dbm",
      "type": "int",
      "unit": "dBm",
      "required": true,
      "desc": "Link quality floor",
      "example": -85,
      "range": [
        -95,
        -75
      ]
    },
    {
      "name": "hold_min",
      "type": "int",
      "unit": "min",
      "required": true,
      "desc": "Link holding time",
      "example": 10,
      "range": [
        5,
        15
      ]
    },
    {
      "name": "separation_m",
      "type": "int",
      "unit": "m",
      "required": true,
      "desc": "Distance between the two ground stations",
      "example": 4200,
      "range": [
        3000,
        6000
      ]
    },
    {
      "name": "min_sep_m",
      "type": "int",
      "unit": "m",
      "required": true,
      "desc": "Minimum separation between relays",
      "example": 100,
      "range": [
        60,
        150
      ]
    }
  ],
  "preconditions": [
    "both ground stations powered and logging",
    "link budget table available"
  ],
  "mission_phases": [
    {
      "phase": "1-plan",
      "actions": [
        "compute relay positions on the {site_a}-{site_b} line",
        "assign one altitude per relay to reduce interference"
      ],
      "output": "relay slot table"
    },
    {
      "phase": "2-deploy",
      "actions": [
        "fly to the slots at {chain_alt_m} m",
        "declare link up"
      ],
      "output": "chain established"
    },
    {
      "phase": "3-hold",
      "actions": [
        "hold the slots for {hold_min} min",
        "report RSSI every minute"
      ],
      "output": "link quality log"
    },
    {
      "phase": "4-recover-link",
      "actions": [
        "replace a lost relay within 45 s",
        "re-balance the slots"
      ],
      "output": "link restored"
    },
    {
      "phase": "5-withdraw",
      "actions": [
        "hand over or land at {lz}"
      ],
      "output": "recovered fleet"
    }
  ],
  "checkpoints": [
    {
      "id": "CP-1",
      "name": "Chain setup",
      "metric": "time to first end-to-end link",
      "target": "<= 180 s",
      "verify": "platform link log",
      "weight": 20
    },
    {
      "id": "CP-2",
      "name": "Link continuity",
      "metric": "fraction of {hold_min} min with RSSI >= {min_rssi_dbm} dBm",
      "target": ">= 98%",
      "verify": "platform link log",
      "weight": 30
    },
    {
      "id": "CP-3",
      "name": "Re-form after loss",
      "metric": "time to restore the link after an injected relay loss",
      "target": "<= 45 s",
      "verify": "platform link log",
      "weight": 20
    },
    {
      "id": "CP-4",
      "name": "Packet delivery",
      "metric": "end-to-end packet loss",
      "target": "<= 2%",
      "verify": "platform link statistic",
      "weight": 15
    },
    {
      "id": "CP-5",
      "name": "Relay separation",
      "metric": "distance between relay stations",
      "target": ">= {min_sep_m} m",
      "verify": "platform proximity monitor",
      "weight": 15
    }
  ],
  "failure_conditions": [
    "link down for more than 60 s in total",
    "relay chain not established by t = 300 s",
    "both relays hovering at the same slot"
  ],
  "constraints": [
    "relay altitude >= {chain_alt_m} m - 20 m",
    "no relay outside the geofence"
  ],
  "generation_rules": {
    "sampling": {
      "hops": [
        2,
        3,
        4
      ],
      "chain_alt_m": [
        80,
        100,
        120,
        140
      ],
      "min_rssi_dbm": [
        -95,
        -90,
        -85,
        -80
      ],
      "hold_min": [
        5,
        8,
        10,
        15
      ]
    },
    "variants": [
      "calm",
      "rain fade",
      "jamming burst"
    ]
  },
  "instance_example": {
    "site_a": "GS-BASE",
    "site_b": "GS-VALLEY",
    "hops": 2,
    "chain_alt_m": 120,
    "min_rssi_dbm": -85,
    "hold_min": 10,
    "separation_m": 4200,
    "min_sep_m": 100
  },
  "grading": "global checkpoint pass rate; checkpoint weights sum to 100"
}
