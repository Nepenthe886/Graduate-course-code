{
  "schema_version": "1.0",
  "template_id": "TT-04",
  "name": "Formation Corridor Transit",
  "language": "en",
  "category": "formation",
  "difficulty": 3,
  "version": "1.0",
  "summary": "Assemble a formation, hold it through a narrow corridor, and arrive on time with the formation intact.",
  "objective": "Assemble a {formation} formation with {spacing_m} m spacing and transit {corridor} end to end within {time_budget_s} s, keeping formation error within tolerance and no separation conflict.",
  "brief": "Fly from {entry} to {exit} through {corridor} in a {formation} formation with {spacing_m} m spacing. Assemble the formation before the corridor entry; inside the corridor there are obstacle edges within {corridor_width_m} m. Keep formation error small, never trigger a separation warning, and complete the transit within {time_budget_s} s.{emcon_text}",
  "agents": {
    "min": 3,
    "max": 5,
    "rec": 4
  },
  "parameters": [
    {
      "name": "corridor",
      "type": "zone_ref",
      "unit": "zone id",
      "required": true,
      "desc": "Corridor geometry identifier",
      "example": "CORRIDOR-URBAN-1"
    },
    {
      "name": "entry",
      "type": "zone_ref",
      "unit": "zone id",
      "required": true,
      "desc": "Corridor entry waypoint",
      "example": "WP-ENTRY-N"
    },
    {
      "name": "exit",
      "type": "zone_ref",
      "unit": "zone id",
      "required": true,
      "desc": "Corridor exit waypoint",
      "example": "WP-EXIT-S"
    },
    {
      "name": "formation",
      "type": "enum",
      "unit": "shape",
      "required": true,
      "desc": "Formation shape",
      "example": "column",
      "choices": [
        "line",
        "column",
        "V",
        "diamond"
      ]
    },
    {
      "name": "spacing_m",
      "type": "int",
      "unit": "m",
      "required": true,
      "desc": "Nominal spacing between neighbours",
      "example": 20,
      "range": [
        10,
        30
      ]
    },
    {
      "name": "time_budget_s",
      "type": "int",
      "unit": "s",
      "required": true,
      "desc": "Transit time budget entry to exit",
      "example": 300,
      "range": [
        240,
        480
      ]
    },
    {
      "name": "corridor_width_m",
      "type": "int",
      "unit": "m",
      "required": true,
      "desc": "Usable corridor width",
      "example": 60,
      "range": [
        40,
        90
      ]
    },
    {
      "name": "emcon",
      "type": "bool",
      "unit": "flag",
      "required": true,
      "desc": "Radio silence inside the corridor",
      "example": false
    }
  ],
  "preconditions": [
    "all UAVs airborne and inside the staging area",
    "formation shape agreed by all members"
  ],
  "mission_phases": [
    {
      "phase": "1-plan",
      "actions": [
        "choose the formation geometry and slot assignment",
        "pick entry and exit alignment"
      ],
      "output": "slot table"
    },
    {
      "phase": "2-assemble",
      "actions": [
        "hold at the staging point",
        "build the {formation} formation with {spacing_m} m spacing"
      ],
      "output": "formation ready at entry"
    },
    {
      "phase": "3-transit",
      "actions": [
        "fly the corridor at constant speed",
        "correct drift back to slot"
      ],
      "output": "fleet at the exit"
    },
    {
      "phase": "4-verify",
      "actions": [
        "check formation error at exit",
        "report transit time"
      ],
      "output": "transit statement"
    },
    {
      "phase": "5-recover",
      "actions": [
        "break formation safely",
        "land at {lz}"
      ],
      "output": "recovered fleet"
    }
  ],
  "checkpoints": [
    {
      "id": "CP-1",
      "name": "Formation assembly",
      "metric": "formation error at corridor entry",
      "target": "<= 0.5 x {spacing_m} m at entry",
      "verify": "platform formation monitor",
      "weight": 20
    },
    {
      "id": "CP-2",
      "name": "Formation hold",
      "metric": "mean and peak formation error inside the corridor",
      "target": "mean <= 3 m, peak <= 6 m",
      "verify": "platform formation monitor",
      "weight": 30
    },
    {
      "id": "CP-3",
      "name": "Transit time",
      "metric": "time from entry to exit",
      "target": "<= {time_budget_s} s",
      "verify": "platform event log",
      "weight": 20
    },
    {
      "id": "CP-4",
      "name": "Separation safety",
      "metric": "separation warnings between members",
      "target": "0 warnings below the {spacing_m} m nominal spacing minus 30%",
      "verify": "platform proximity monitor",
      "weight": 15
    },
    {
      "id": "CP-5",
      "name": "Comms discipline",
      "metric": "radio transmissions inside the corridor",
      "target": "{emcon_target}",
      "verify": "platform link log",
      "weight": 15
    }
  ],
  "failure_conditions": [
    "corridor obstacle strike",
    "formation broken for more than 30 s",
    "UAV exits the corridor volume"
  ],
  "constraints": [
    "constant speed inside the corridor",
    "no re-planning that changes slot order mid-corridor"
  ],
  "generation_rules": {
    "sampling": {
      "formation": [
        "line",
        "column",
        "V",
        "diamond"
      ],
      "spacing_m": [
        10,
        15,
        20,
        25,
        30
      ],
      "time_budget_s": [
        240,
        300,
        360,
        480
      ],
      "emcon": [
        true,
        false
      ]
    },
    "variants": [
      "day",
      "dusk",
      "crosswind"
    ]
  },
  "instance_example": {
    "corridor": "CORRIDOR-URBAN-1",
    "entry": "WP-ENTRY-N",
    "exit": "WP-EXIT-S",
    "formation": "column",
    "spacing_m": 20,
    "time_budget_s": 300,
    "corridor_width_m": 60,
    "emcon": false
  },
  "grading": "global checkpoint pass rate; checkpoint weights sum to 100"
}
