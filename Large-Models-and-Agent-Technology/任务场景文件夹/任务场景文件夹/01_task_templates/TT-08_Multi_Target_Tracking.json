{
  "schema_version": "1.0",
  "template_id": "TT-08",
  "name": "Multi-Target Tracking",
  "language": "en",
  "category": "tracking",
  "difficulty": 4,
  "version": "1.0",
  "summary": "Track several moving ground targets simultaneously, keep track quality and hand targets between UAVs.",
  "objective": "Track {n_targets} independent ground targets inside {track_area} for {duration_min} min, keeping each target locked for at least 90% of the time and handing targets between UAVs without losing track.",
  "brief": "{n_targets} vehicles move inside {track_area}. Keep every target under continuous observation for {duration_min} min from no closer than {min_standoff_m} m and no further than {max_standoff_m} m. When a target crosses into another UAV's sector, hand it over so that no track is lost for more than 10 s. Report target count and positions every 30 s.",
  "agents": {
    "min": 2,
    "max": 5,
    "rec": 3
  },
  "parameters": [
    {
      "name": "track_area",
      "type": "zone_ref",
      "unit": "zone id",
      "required": true,
      "desc": "Area containing the moving targets",
      "example": "AREA-MARKET"
    },
    {
      "name": "n_targets",
      "type": "int",
      "unit": "targets",
      "required": true,
      "desc": "Number of moving targets",
      "example": 3,
      "range": [
        2,
        5
      ]
    },
    {
      "name": "duration_min",
      "type": "int",
      "unit": "min",
      "required": true,
      "desc": "Tracking duration",
      "example": 10,
      "range": [
        5,
        15
      ]
    },
    {
      "name": "min_standoff_m",
      "type": "int",
      "unit": "m",
      "required": true,
      "desc": "Closest approach to a target",
      "example": 60,
      "range": [
        40,
        100
      ]
    },
    {
      "name": "max_standoff_m",
      "type": "int",
      "unit": "m",
      "required": true,
      "desc": "Furthest acceptable standoff for track quality",
      "example": 250,
      "range": [
        150,
        400
      ]
    }
  ],
  "preconditions": [
    "target telemetry enabled on the platform",
    "payload gimbal calibrated"
  ],
  "mission_phases": [
    {
      "phase": "1-plan",
      "actions": [
        "divide {track_area} into observation sectors",
        "assign primary and backup observed per sector"
      ],
      "output": "sector and target assignment"
    },
    {
      "phase": "2-acquire",
      "actions": [
        "find all {n_targets} targets",
        "declare lock per target"
      ],
      "output": "all targets locked"
    },
    {
      "phase": "3-maintain",
      "actions": [
        "keep standoff between {min_standoff_m} and {max_standoff_m} m",
        "report counts every 30 s"
      ],
      "output": "track log"
    },
    {
      "phase": "4-handoff",
      "actions": [
        "hand targets that cross sectors",
        "confirm the receiving UAV has the lock"
      ],
      "output": "handoff records"
    },
    {
      "phase": "5-complete",
      "actions": [
        "report final target set",
        "recover to {lz}"
      ],
      "output": "tracking summary"
    }
  ],
  "checkpoints": [
    {
      "id": "CP-1",
      "name": "Acquisition",
      "metric": "time until all {n_targets} targets are locked",
      "target": "<= 120 s",
      "verify": "platform tracking log",
      "weight": 20
    },
    {
      "id": "CP-2",
      "name": "Per-target continuity",
      "metric": "fraction of {duration_min} min with each target locked",
      "target": ">= 90% per target",
      "verify": "platform tracking log",
      "weight": 30
    },
    {
      "id": "CP-3",
      "name": "Standoff window",
      "metric": "distance to tracked targets",
      "target": "all lock samples within {min_standoff_m}-{max_standoff_m} m",
      "verify": "platform range telemetry",
      "weight": 20
    },
    {
      "id": "CP-4",
      "name": "Handoff quality",
      "metric": "track gap during sector handoff",
      "target": "no gap longer than 10 s",
      "verify": "platform tracking log",
      "weight": 15
    },
    {
      "id": "CP-5",
      "name": "Safety",
      "metric": "separation between tracking UAVs",
      "target": ">= 40 m at all times",
      "verify": "platform proximity monitor",
      "weight": 15
    }
  ],
  "failure_conditions": [
    "two or more targets lost at the same time",
    "entering the {min_standoff_m} m standoff of any target",
    "UAV-UAV separation warning"
  ],
  "constraints": [
    "no target identification reveal before classification is complete",
    "no descent below 50 m over the track area"
  ],
  "generation_rules": {
    "sampling": {
      "n_targets": [
        2,
        3,
        4,
        5
      ],
      "duration_min": [
        5,
        8,
        10,
        15
      ],
      "min_standoff_m": [
        40,
        60,
        80
      ],
      "max_standoff_m": [
        150,
        200,
        250,
        400
      ]
    },
    "variants": [
      "day",
      "night thermal",
      "occlusion by buildings"
    ]
  },
  "instance_example": {
    "track_area": "AREA-MARKET",
    "n_targets": 3,
    "duration_min": 10,
    "min_standoff_m": 60,
    "max_standoff_m": 250
  },
  "grading": "global checkpoint pass rate; checkpoint weights sum to 100"
}
