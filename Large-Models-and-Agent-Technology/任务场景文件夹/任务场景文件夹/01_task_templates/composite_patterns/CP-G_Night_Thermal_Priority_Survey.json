{
  "schema_version": "1.0",
  "template_id": "CP-G",
  "name": "Night Thermal Priority Survey",
  "language": "en",
  "category": "composite",
  "difficulty": 3,
  "version": "1.0",
  "derived_from": [
    "TT-01",
    "TT-09"
  ],
  "summary": "A thermal-only survey of a priority block at night with a hard sensor and altitude constraint.",
  "objective": "Survey {area} at night with the thermal sensor only at {altitude_m} m, reaching {coverage_pct} % coverage and flagging every hotspot above {hotspot_c} degC.",
  "brief": "It is night and only the thermal payload works. Survey {area} at {altitude_m} m to {coverage_pct} % coverage, and report every thermal hotspot above {hotspot_c} degC with its position and peak temperature. The RGB camera must not be used, and no illumination is allowed. Re-visit any hotspot once to confirm it before reporting.",
  "agents": {
    "min": 2,
    "max": 3,
    "rec": 2
  },
  "parameters": [
    {
      "name": "area",
      "type": "zone_ref",
      "required": true,
      "desc": "Priority block",
      "example": "BLOCK-A4"
    },
    {
      "name": "coverage_pct",
      "type": "int",
      "unit": "%",
      "required": true,
      "desc": "Coverage target",
      "example": 90,
      "range": [
        85,
        95
      ]
    },
    {
      "name": "altitude_m",
      "type": "int",
      "unit": "m AGL",
      "required": true,
      "desc": "Thermal survey altitude",
      "example": 80,
      "range": [
        60,
        100
      ]
    },
    {
      "name": "hotspot_c",
      "type": "int",
      "unit": "degC",
      "required": true,
      "desc": "Hotspot threshold",
      "example": 120,
      "range": [
        80,
        200
      ]
    },
    {
      "name": "confirm_revisit",
      "type": "bool",
      "unit": "flag",
      "required": true,
      "desc": "Require a confirmation pass per hotspot",
      "example": true
    }
  ],
  "mission_phases": [
    {
      "phase": "1-plan",
      "actions": [
        "plan thermal tracks at {altitude_m} m",
        "declare the hotspot threshold"
      ],
      "output": "thermal survey plan"
    },
    {
      "phase": "2-survey",
      "actions": [
        "fly the tracks with the thermal payload",
        "record the thermal mosaic"
      ],
      "output": "thermal raster"
    },
    {
      "phase": "3-confirm",
      "actions": [
        "re-visit each hotspot once",
        "record peak temperature"
      ],
      "output": "confirmed hotspot list"
    },
    {
      "phase": "4-report",
      "actions": [
        "report positions and peaks",
        "recover"
      ],
      "output": "hotspot report"
    }
  ],
  "checkpoints": [
    {
      "id": "CP-1",
      "name": "Coverage",
      "metric": "thermal union coverage of {area}",
      "target": ">= {coverage_pct} %",
      "verify": "platform coverage grid",
      "weight": 30
    },
    {
      "id": "CP-2",
      "name": "Sensor discipline",
      "metric": "RGB frames taken during the survey",
      "target": "0 RGB frames",
      "verify": "payload log",
      "weight": 20
    },
    {
      "id": "CP-3",
      "name": "Hotspot detection",
      "metric": "hotspots found above {hotspot_c} degC versus ground truth",
      "target": ">= 90% of true hotspots, <= 1 false positive",
      "verify": "payload and ground truth comparison",
      "weight": 25
    },
    {
      "id": "CP-4",
      "name": "Confirmation pass",
      "metric": "re-visits per hotspot",
      "target": ">= 1 re-visit per reported hotspot",
      "verify": "payload log",
      "weight": 15
    },
    {
      "id": "CP-5",
      "name": "Recovery",
      "metric": "all UAVs landed",
      "target": "all on ground at the nearest landing zone",
      "verify": "platform landing log",
      "weight": 10
    }
  ],
  "failure_conditions": [
    "RGB used during the survey",
    "no illumination allowed: any searchlight event",
    "coverage below 75%"
  ],
  "constraints": [
    "no illumination",
    "thermal payload is the only sensor",
    "altitude >= 60 m"
  ],
  "generation_rules": {
    "sampling": {
      "coverage_pct": [
        85,
        90,
        95
      ],
      "altitude_m": [
        60,
        80,
        100
      ],
      "hotspot_c": [
        80,
        120,
        200
      ]
    },
    "variants": [
      "clear night",
      "cold night"
    ]
  },
  "grading": "global checkpoint pass rate; checkpoint weights sum to 100"
}
